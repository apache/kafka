package org.apache.kafka.common.compress;

import org.apache.kafka.common.utils.BufferSupplier;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.nio.ByteBuffer;
import java.util.Random;

import static org.junit.jupiter.api.Assertions.assertArrayEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * Tests for LZ4 content checksum verification in Lz4BlockInputStream.
 */
public class Lz4ContentChecksumTest {

    private static final int SEED = 12345;
    private Random random;

    @BeforeEach
    public void setUp() {
        random = new Random(SEED);
    }

    @AfterEach
    public void tearDown() {
        random = null;
    }

    @Test
    public void testRoundTripWithContentChecksum() throws IOException {
        byte[] originalData = new byte[1024];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);
        ByteBuffer decompressed = decompress(compressed);
        assertArrayEquals(originalData, decompressed.array());
    }

    @Test
    public void testRoundTripWithoutContentChecksum() throws IOException {
        byte[] originalData = new byte[1024];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, false);
        ByteBuffer decompressed = decompress(compressed);
        assertArrayEquals(originalData, decompressed.array());
    }

    @Test
    public void testSingleBlockWithContentChecksum() throws IOException {
        byte[] originalData = new byte[100];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);
        ByteBuffer decompressed = decompress(compressed);
        assertArrayEquals(originalData, decompressed.array());
    }

    @Test
    public void testMultipleBlocksWithContentChecksum() throws IOException {
        byte[] originalData = new byte[100 * 1024];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);
        ByteBuffer decompressed = decompress(compressed);
        assertArrayEquals(originalData, decompressed.array());
    }

    @Test
    public void testEmptyDataWithContentChecksum() throws IOException {
        byte[] originalData = new byte[0];

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);
        ByteBuffer decompressed = decompress(compressed);
        assertArrayEquals(originalData, decompressed.array());
    }

    @Test
    public void testContentChecksumMismatch() throws IOException {
        byte[] originalData = new byte[1024];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);

        int corruptPosition = compressed.limit() / 2;
        compressed.position(corruptPosition);
        compressed.put(corruptPosition, (byte) (compressed.get(corruptPosition) ^ 0xFF));
        compressed.position(0);

        IOException exception = assertThrows(IOException.class, () -> {
            decompress(compressed);
        });
        assertTrue(exception.getMessage().contains("Content checksum mismatch"));
    }

    @Test
    public void testDirectBufferWithContentChecksum() throws IOException {
        byte[] originalData = new byte[1024];
        random.nextBytes(originalData);

        ByteBuffer compressed = compressWithContentChecksum(originalData, true);

        ByteBuffer directBuffer = ByteBuffer.allocateDirect(compressed.remaining());
        directBuffer.put(compressed);
        directBuffer.position(0);

        Lz4BlockInputStream decompressor = new Lz4BlockInputStream(
            directBuffer,
            BufferSupplier.create(),
            false
        );

        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        byte[] buffer = new byte[1024];
        int read;
        while ((read = decompressor.read(buffer)) != -1) {
            baos.write(buffer, 0, read);
        }
        decompressor.close();

        assertArrayEquals(originalData, baos.toByteArray());
    }

    private ByteBuffer compressWithContentChecksum(byte[] data, boolean useContentChecksum) throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        Lz4BlockOutputStream compressor = new Lz4BlockOutputStream(
            baos,
            BufferSupplier.create(),
            useContentChecksum,
            false
        );
        compressor.write(data);
        compressor.close();
        return ByteBuffer.wrap(baos.toByteArray());
    }

    private ByteBuffer decompress(ByteBuffer compressed) throws IOException {
        Lz4BlockInputStream decompressor = new Lz4BlockInputStream(
            compressed,
            BufferSupplier.create(),
            false
        );

        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        byte[] buffer = new byte[4096];
        int read;
        while ((read = decompressor.read(buffer)) != -1) {
            baos.write(buffer, 0, read);
        }
        decompressor.close();
        return ByteBuffer.wrap(baos.toByteArray());
    }
}</parameter>
