      "fields": [
        {
          "name": "ConfigKey", "type": "string", "versions": "0+",
          "about": "The configuration key."
        },
        {
          "name": "ConfigValue", "type": "string", "versions": "0+",
          "about": "The configuration value."
        },
        {
          "name": "ConfigType", "type": "int16", "versions": "0+",
