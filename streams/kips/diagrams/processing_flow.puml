@startuml
!theme plain

title RangedKStream Processing Flow

participant "Upstream\nProcessor" as UP
participant "Buffer\nProcessor" as BP
participant "WindowStore\n(Shared Buffer)" as WS
participant "Aggregate\nProcessor" as AP
participant "Range" as R
participant "RangeAggregator" as RA
participant "Downstream\nProcessor" as DOWN

UP -> BP : process(record)
activate BP

alt null key or null value
    note right of BP : record dropped\n(droppedRecordsSensor)
else record.timestamp() < observedStreamTime - gracePeriodMs
    note right of BP : record dropped\n(past grace period)
else record valid
    BP -> BP : update observedStreamTime

    BP -> WS : put(key, value, timestamp)
    activate WS
    deactivate WS

    BP -> AP : forward(record)
    activate AP

    AP -> R : fetch(record, store)
    activate R

    R -> WS : fetch(key, fromTimestamp, toTimestamp)
    activate WS
    WS --> R : WindowStoreIterator<V>
    deactivate WS

    R --> AP : Iterable<Record<K, V>>
    deactivate R

    AP -> RA : apply(anchor, rangeRecords)
    activate RA
    RA --> AP : VR result
    deactivate RA

    AP -> DOWN : forward(anchor.withValue(result))
    deactivate AP
end

deactivate BP

@enduml
