// Version 1 adds the OfflineLogDirs flexible field
// Version 2 adds the CordonedLogDirs flexible field
// Version 3 adds the LeaderlessReplicas flexible field (KIP-966)
{
  "apiKey": 63,
  "type": "request",
  "listeners": ["controller"],
  "name": "BrokerHeartbeatRequest",
  "validVersions": "0-3",
  "flexibleVersions": "0+",
  "headerVersions": {
    "0+": "2"
  },
  "fields": [
    { "name": "BrokerId", "type": "int32", "versions": "0+", "entityType": "brokerId",
      "about": "The broker ID." },
    { "name": "BrokerEpoch", "type": "int64", "versions": "0+", "default": "-1",
      "about": "The broker epoch." },
    { "name": "CurrentMetadataOffset", "type": "int64", "versions": "0+",
      "about": "The highest metadata offset which the broker has reached." },
    { "name": "WantFence", "type": "bool", "versions": "0+",
      "about": "True if the broker wants to be fenced, false otherwise." },
    { "name": "WantShutDown", "type": "bool", "versions": "0+",
      "about": "True if the broker wants to be shut down, false otherwise." },
    { "name": "OfflineLogDirs", "type":  "[]uuid", "versions": "1+", "taggedVersions": "1+", "tag": 0,
      "about": "Log directories that failed and went offline." },
    { "name": "CordonedLogDirs", "type":  "[]uuid", "versions": "2+", "taggedVersions": "2+", "tag": 1,
      "nullableVersions": "2+", "default": "null",
      "about": "List of log directories that are cordoned. This is null before the broker reaches the RECOVERY state." },
    { "name": "LeaderlessReplicas", "type": "[]LeaderlessReplica", "versions": "3+", "taggedVersions": "3+", "tag": 2,
      "about": "The log end offsets of local replicas of leaderless partitions, used for unclean recovery.", "fields": [
      { "name": "TopicId", "type": "uuid", "versions": "3+", "about": "The topic ID." },
      { "name": "PartitionIndex", "type": "int32", "versions": "3+", "about": "The partition index." },
      { "name": "CurrentLeaderEpoch", "type": "int32", "versions": "3+", "about": "The partition leader epoch known by the broker." },
      { "name": "LastWrittenLeaderEpoch", "type": "int32", "versions": "3+", "about": "The leader epoch of the last record in the local log." },
      { "name": "LogEndOffset", "type": "int64", "versions": "3+", "about": "The log end offset of the local log." }
    ]}
  ]
}
